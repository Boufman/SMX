# inspect_status.py
from selenium import webdriver
from selenium.webdriver.chrome.options import Options
from selenium.webdriver.common.by import By

opts = Options()
opts.add_experimental_option("debuggerAddress", "127.0.0.1:9222")
driver = webdriver.Chrome(options=opts)

iframe = driver.execute_script("""
    return document.querySelector('force-aloha-page')
                   .shadowRoot.querySelector('iframe');
""")
driver.switch_to.frame(iframe)

print("\n=== elements named SVMX_Status__c ===")
els = driver.find_elements(By.NAME, "SVMX_Status__c")
print(f"Found {len(els)}")
for i, el in enumerate(els):
    print(f"\n[{i}] tag={el.tag_name}  type={el.get_attribute('type')}")
    print(f"    class={el.get_attribute('class')}")
    print(f"    role={el.get_attribute('role')}")
    print(f"    readonly={el.get_attribute('readonly')}")
    print(f"    is_displayed={el.is_displayed()}  is_enabled={el.is_enabled()}")
    print("    outerHTML:")
    print("   ", (el.get_attribute("outerHTML") or "")[:500])

print("\n=== ancestor comboboxes ===")
for i, cb in enumerate(driver.find_elements(By.TAG_NAME, "lightning-base-combobox")):
    print(f"[{i}] name={cb.get_attribute('name')} data-id={cb.get_attribute('data-id')}")

print("\n=== buttons near SVMX_Status ===")
for i, b in enumerate(driver.find_elements(By.XPATH, "//button[contains(@name,'Status') or contains(@data-id,'Status')]")):
    print(f"[{i}] name={b.get_attribute('name')} data-id={b.get_attribute('data-id')} text='{b.text}'")

input("\nPress Enter to close...")