# dump_all.py
from selenium import webdriver
from selenium.webdriver.chrome.options import Options
from selenium.webdriver.common.by import By

opts = Options()
opts.add_experimental_option("debuggerAddress", "127.0.0.1:9222")
driver = webdriver.Chrome(options=opts)

iframe = driver.execute_script("""
    return document.querySelector('force-aloha-page')
                   .shadowRoot.querySelector('iframe');
""")
driver.switch_to.frame(iframe)

# Make sure you're ON the PICKLISTS tab in the browser right now

tags = ["input", "select", "button", "lightning-base-combobox",
        "lightning-combobox", "lightning-input"]

seen = set()
for tag in tags:
    for el in driver.find_elements(By.TAG_NAME, tag):
        key = (tag, el.get_attribute("name"), el.get_attribute("data-id"),
               el.get_attribute("data-field-api-name"))
        if key in seen:
            continue
        seen.add(key)

        name = el.get_attribute("name")
        did  = el.get_attribute("data-id")
        api  = el.get_attribute("data-field-api-name")
        typ  = el.get_attribute("type")
        cls  = (el.get_attribute("class") or "")[:60]
        disp = el.is_displayed()

        # only print things that look interesting
        hay = " ".join(str(x) for x in (name, did, api, cls)).lower()
        if any(k in hay for k in ("status", "pass", "picklist", "result")):
            print(f"<{tag}> name={name!r} id={did!r} api={api!r} "
                  f"type={typ!r} visible={disp} class={cls!r}")

print("\n--- all visible selects on page ---")
for s in driver.find_elements(By.TAG_NAME, "select"):
    if s.is_displayed():
        print(f"select name={s.get_attribute('name')!r} "
              f"options={[o.text for o in s.find_elements(By.TAG_NAME,'option')][:10]}")

input("\nPress Enter to close...")