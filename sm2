from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC

def set_lightning_picklist(driver, field_name, value):
    # 1. Click the combobox button that carries the field name
    btn = WebDriverWait(driver, 15).until(
        EC.element_to_be_clickable((By.CSS_SELECTOR, f"button[name='{field_name}']"))
    )
    driver.execute_script("arguments[0].scrollIntoView({block:'center'});", btn)
    btn.click()

    # 2. Wait for the dropdown and click the matching option
    opt = WebDriverWait(driver, 15).until(
        EC.element_to_be_clickable((
            By.XPATH,
            f"//lightning-base-combobox-item[@data-value='{value}']"
            f" | //*[@role='option' and normalize-space()='{value}']"
        ))
    )
    opt.click()