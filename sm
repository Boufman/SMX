# ============================================================
# ATTACH TO LIVE SERVICEMAX SESSION
# ============================================================

def attach_to_servicemax():

    options = Options()
    options.add_experimental_option(
        "debuggerAddress",
        "127.0.0.1:9222"
    )

    driver = webdriver.Chrome(options=options)

    iframe = driver.execute_script("""
        return document
            .querySelector('force-aloha-page')
            .shadowRoot
            .querySelector('iframe');
    """)

    driver.switch_to.frame(iframe)

    return driver


# ============================================================
# HELPERS
# ============================================================

def wait_name(driver, name, timeout=30):

    return WebDriverWait(driver, timeout).until(
        EC.element_to_be_clickable(
            (By.NAME, name)
        )
    )


def click_xpath(driver, xpath, timeout=30):

    return WebDriverWait(driver, timeout).until(
        EC.element_to_be_clickable(
            (By.XPATH, xpath)
        )
    ).click()


def set_text(element, value):

    element.click()

    try:
        element.clear()
    except:
        pass

    element.send_keys(Keys.CONTROL, "a")
    element.send_keys(Keys.DELETE)
    element.send_keys(value)


